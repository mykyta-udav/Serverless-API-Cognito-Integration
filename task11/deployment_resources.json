{
  "lambda-basic-execution": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:Scan",
            "dynamodb:Batch*",
            "dynamodb:DeleteItem",
            "ssm:PutParameter",
            "ssm:GetParameter",
            "kms:Decrypt",
            "cognito-idp:*"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "api_handler-role": {
    "predefined_policies": [],
    "principal_service": "lambda",
    "custom_policies": [
      "lambda-basic-execution"
    ],
    "resource_type": "iam_role",
    "tags": {}
  },
  "simple-booking-userpool": {
    "resource_type": "cognito_idp",
    "password_policy": {
      "minimum_length": 12,
      "require_uppercase": true,
      "require_symbols": true,
      "require_lowercase": true,
      "require_numbers": true
    },
    "auto_verified_attributes": [
      "email"
    ],
    "sms_configuration": {},
    "username_attributes": [
      "email"
    ],
    "custom_attributes": [],
    "client": {
      "client_name": "api-client",
      "generate_secret": false,
      "explicit_auth_flows": [
        "ALLOW_ADMIN_USER_PASSWORD_AUTH",
        "ALLOW_USER_SRP_AUTH",
        "ALLOW_REFRESH_TOKEN_AUTH",
        "ALLOW_USER_PASSWORD_AUTH"
      ]
    },
    "tags": {}
  },
  "task11_api": {
    "resource_type": "api_gateway",
    "deploy_stage": "api",
    "authorizers": {
      "cognito-authorizer": {
        "type": "COGNITO_USER_POOLS",
        "identity_source": "method.request.header.Authorization",
        "user_pools": [
          "simple-booking-userpool"
        ]
      }
    },
    "dependencies": [
      {
        "resource_name": "api_handler",
        "resource_type": "lambda"
      },
      {
        "resource_name": "simple-booking-userpool",
        "resource_type": "cognito_idp"
      }
    ],
    "resources": {
      "/signup": {
        "enable_cors": true,
        "POST": {
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "api_handler",
          "enable_proxy": true
        }
      },
      "/signin": {
        "enable_cors": true,
        "POST": {
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "api_handler",
          "enable_proxy": true
        }
      },
      "/tables": {
        "enable_cors": true,
        "GET": {
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "api_handler",
          "enable_proxy": true
        },
        "POST": {
          "authorization_type": "cognito-authorizer",
          "integration_type": "lambda",
          "lambda_name": "api_handler",
          "enable_proxy": true
        }
      },
      "/tables/{tableId}": {
        "enable_cors": true,
        "GET": {
          "authorization_type": "cognito-authorizer",
          "integration_type": "lambda",
          "lambda_name": "api_handler",
          "enable_proxy": true
        }
      },
      "/reservations": {
        "enable_cors": true,
        "POST": {
          "authorization_type": "cognito-authorizer",
          "integration_type": "lambda",
          "lambda_name": "api_handler",
          "enable_proxy": true
        },
        "GET": {
          "authorization_type": "cognito-authorizer",
          "integration_type": "lambda",
          "lambda_name": "api_handler",
          "enable_proxy": true
        }
      }
    }
  },
  "Tables": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "N",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "Reservations": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "reservationId",
    "hash_key_type": "S",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  }
}